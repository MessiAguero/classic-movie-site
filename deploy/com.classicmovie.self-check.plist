<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.classicmovie.self-check</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/admin/codex/0806/classic-movie-site/tools/self-check.sh</string>
	</array>
	<!-- 开机后先自检一次，把停机期间积压的内容补上 -->
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/tmp/classicmovie-selfcheck.err.log</string>
	<key>StandardOutPath</key>
	<string>/tmp/classicmovie-selfcheck.log</string>

	<!-- 每小时自检一次：同步是否及时、海报是否出错 -->
	<key>StartInterval</key>
	<integer>3600</integer>

	<!-- WorkBuddy 生成新页面时也自检一次：万一同步那一步失败，自检会兜住并补上 -->
	<key>WatchPaths</key>
	<array>
		<string>/Users/admin/WorkBuddy/automation-20260423112820</string>
	</array>
	<key>ThrottleInterval</key>
	<integer>300</integer>
</dict>
</plist>
