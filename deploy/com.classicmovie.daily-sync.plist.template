<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.classicmovie.daily-sync</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>@@ROOT@@/tools/daily-sync.sh</string>
	</array>
	<key>WorkingDirectory</key>
	<string>@@ROOT@@</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>@@PATH@@</string>
		<key>GIT_TERMINAL_PROMPT</key>
		<string>0</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>@@HOME@@/Library/Logs/classic-movie-site/sync.err.log</string>
	<key>StandardOutPath</key>
	<string>@@HOME@@/Library/Logs/classic-movie-site/sync.log</string>
	<key>StartInterval</key>
	<integer>900</integer>
	<key>WatchPaths</key>
	<array>
		<string>@@SRC@@</string>
	</array>
	<key>ThrottleInterval</key>
	<integer>60</integer>
</dict>
</plist>
