<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.classicmovie.poster-qa</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>@@ROOT@@/tools/poster-qa.sh</string>
	</array>
	<key>WorkingDirectory</key>
	<string>@@ROOT@@</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>@@PATH@@</string>
		<key>GIT_TERMINAL_PROMPT</key>
		<string>0</string>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>@@HOME@@/Library/Logs/classic-movie-site/poster-qa.err.log</string>
	<key>StandardOutPath</key>
	<string>@@HOME@@/Library/Logs/classic-movie-site/poster-qa.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>3</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
</dict>
</plist>
