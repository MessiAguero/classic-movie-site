<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.classicmovie.daily-sync</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/admin/codex/0806/classic-movie-site/tools/daily-sync.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/tmp/classicmovie-sync.err.log</string>
	<key>StandardOutPath</key>
	<string>/tmp/classicmovie-sync.log</string>
	<!-- 每 6 小时检查一次（21600 秒），避免睡眠错过固定时刻 -->
	<key>StartInterval</key>
	<integer>21600</integer>
</dict>
</plist>
