<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.classicmovie.daily-sync</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/admin/codex/0806/classic-movie-site/tools/daily-sync.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/tmp/classicmovie-sync.err.log</string>
	<key>StandardOutPath</key>
	<string>/tmp/classicmovie-sync.log</string>
	<!-- 每 3 小时检查一次（10800 秒），避免睡眠错过固定时刻 -->
	<key>StartInterval</key>
	<integer>900</integer>

	<!-- WorkBuddy 生成新页面时立即触发同步（准实时） -->
	<key>WatchPaths</key>
	<array>
		<string>/Users/admin/WorkBuddy/automation-20260423112820</string>
	</array>

	<!-- 两次触发的最小间隔，避免频繁抖动 -->
	<key>ThrottleInterval</key>
	<integer>60</integer>
</dict>
</plist>
